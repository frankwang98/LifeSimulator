<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3">

    <BehaviorTree ID="NavTree">
        <Sequence name="root_sequence">

            <PrintMessage msg="== NavTree: heading to (10, 5) =="/>

            <NavToPose name="go_to_first_target"
